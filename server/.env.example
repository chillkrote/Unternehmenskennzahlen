# Kopieren nach server/.env und Werte setzen. server/.env steht in .gitignore und gehört nie ins Repo.
# Passwörter: z. B. `openssl rand -base64 30`
POSTGRES_PASSWORD=bitte-setzen-admin
SPHAERAE_API_PASSWORD=bitte-setzen-api
# Adresse der Website: lokal ":80" (nur HTTP), auf dem Server "sphaerae.de" (Caddy holt das Let's-Encrypt-Zertifikat selbst)
SITE_ADDRESS=:80
# Browser-Ursprünge außerhalb der eigenen Domain, die die API lesen dürfen (z. B. die GitHub-Pages-Fassung während der Migration)
API_CORS_ORIGINS=http://localhost:8080,https://chillkrote.github.io
API_RATE_LIMIT_PER_MINUTE=240
PLATTFORM_UMGEBUNG=entwicklung
