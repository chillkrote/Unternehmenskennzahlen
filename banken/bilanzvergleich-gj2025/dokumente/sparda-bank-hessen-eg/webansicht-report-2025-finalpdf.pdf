   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Pleasant family couple sitting at big wooden table in modern kitchen, looking at laptop screen. Happy young mixed race married spouse web surfing, making purchases online or booking flight tickets.</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Couple - Relationship</rdf:li>
     <rdf:li>Laptop</rdf:li>
     <rdf:li>Internet</rdf:li>
